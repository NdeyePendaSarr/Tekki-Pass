# Copy to `.env` and adjust. `.env` is git-ignored: never commit real values.
# Production secrets live in the hosting platform's secret store, not in files.

# Bitcoin network: testnet | mainnet (see docs/adr/0004). Keep testnet unless you are doing a mainnet demo.
NETWORK=testnet

# Host ports, if the defaults are already taken on your machine.
# API_PORT=8000
# WEB_PORT=3000
# RELAY_PORT=7777

# Lightning backend. Only "fake" exists until the Breez API key arrives (docs/adr/0005):
# invoices are settled with POST /dev/attestation-requests/{token}/simulate-payment.
# The fake backend is refused on mainnet and may only publish to local relays.
# LIGHTNING_BACKEND=fake

# Artisan authentication (NIP-98): requests are signed with the artisan Nostr key.
# Required by default; docker-compose disables it until the web app signs requests.
# NIP98_REQUIRED=true
# Public base URLs the signature may target (the web proxy and the API itself), JSON array.
# NIP98_URL_PREFIXES=["https://tekki-pass.example/api","https://api.tekki-pass.example"]

# Badge definition (NIP-58 kind 30009): published to the relays at API start, in the background.
# Manual publication: docker compose exec api python -m app.attestations.definition
# PUBLISH_BADGE_DEFINITION_ON_STARTUP=true
# Optional public https image shown by Nostr clients for the badge.
# BADGE_IMAGE_URL=https://tekki-pass.example/badge.png

# Rate limits per client IP, per minute (429 + Retry-After when exceeded).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_CREATE_PER_MINUTE=10
# RATE_LIMIT_CONFIRM_PER_MINUTE=10
# RATE_LIMIT_REFRESH_PER_MINUTE=40
# RATE_LIMIT_LIST_PER_MINUTE=30
# Reverse proxies whose X-Forwarded-For is trusted (JSON array of networks). In production,
# set the hosting platform proxy network, or every user shares the proxy IP limit.
# TRUSTED_PROXIES=["10.0.0.0/8"]

# Anti-collusion cap and fee (docs/adr/0003). The fee is a placeholder until the interviews.
# ATTESTATION_FEE_SAT=210
# MAX_ATTESTATIONS_PER_CLIENT=5

# PostgreSQL (local development only)
POSTGRES_USER=tekki
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=tekki_pass

# Breez SDK - Spark API key (docs/adr/0005), requested from breez.technology. Never commit it.
# BREEZ_API_KEY=

# Nostr issuer secret key (nsec1... or hex) used to sign attestations (docs/adr/0002).
# Never commit it. Generate a throwaway key for local development; leave empty otherwise.
NOSTR_ISSUER_NSEC=

# Public relays attestations are published to (JSON array) and how many must accept each one.
# Defaults: relay.damus.io, nos.lol, relay.primal.net, with 2 acknowledgements required.
# NOSTR_RELAYS=["wss://relay.damus.io","wss://nos.lol","wss://relay.primal.net"]
# NOSTR_MIN_RELAY_ACKS=2
# Relays the verification page reads from, if browsers must use other addresses (JSON array).
# PUBLIC_RELAYS=["wss://relay.damus.io","wss://nos.lol","wss://relay.primal.net"]

# Secret mixed into the client phone hash (HMAC-SHA256). Without it the hash of a
# 9-digit number can be reversed. Use a long random value, e.g. `openssl rand -hex 32`.
CLIENT_PHONE_PEPPER=
