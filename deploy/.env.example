# Production settings. Copy to deploy/.env ON THE SERVER ONLY and fill in.
# deploy/.env is git-ignored: never commit it, never paste it in a chat or an issue.

# Public domain pointing to the server (A record). Caddy gets the HTTPS certificate.
DOMAIN=tekki-pass.example.com

# testnet | mainnet (docs/adr/0004). The fake payment backend refuses mainnet.
NETWORK=testnet

# Generate each secret on the server, see deploy/README.md ("Secrets").
POSTGRES_PASSWORD=
NOSTR_ISSUER_NSEC=
CLIENT_PHONE_PEPPER=

# fake = simulated payments (until the Breez API key). Do not change for now.
LIGHTNING_BACKEND=fake
